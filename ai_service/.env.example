HG_AI_HOST=127.0.0.1
HG_AI_PORT=8001
HG_AI_PROVIDER=ollama
HG_AI_OLLAMA_ENDPOINT=http://127.0.0.1:11434
HG_AI_MODEL=llama3.2:3b
HG_AI_REQUEST_TIMEOUT=10
HG_AI_MAX_CONCURRENT_INVESTIGATIONS=2
HG_AI_MAX_TOOL_CALLS=4
HG_AI_MAX_RETRY_ROUNDS=0
HG_AI_LOG_LEVEL=INFO
# Optional: trusted operator-configured paths, never accepted in HTTP requests.
# HG_AI_RETRIEVAL_INDEX=local-data/index.json
# HG_AI_EMBEDDING_MODEL_PATH=local-data/models/minilm
# HG_AI_RETRIEVAL_CORPUS_VERSION=<64-character corpus version>
HG_AI_RETRIEVAL_RRF_CONSTANT=60
HG_AI_RETRIEVAL_MIN_SIMILARITY=0.35
HG_AI_WORKFLOW_TIMEOUT=90
HG_AI_GENERATION_TIMEOUT=60
HG_AI_WORKFLOW_STEP_LIMIT=16
HG_AI_WORKFLOW_TOOL_LIMIT=6
HG_AI_WORKFLOW_RETRY_LIMIT=1
HG_AI_WORKFLOW_RETRIEVAL_K=3
HG_AI_GENERATION_CONTEXT_CHARS=6000
HG_AI_GENERATION_TOKENS=256
HG_AI_DNS_LOG_RETENTION_HOURS=168
HG_AI_IDENTITY_LOG_RETENTION_HOURS=168
HG_AI_DIAGNOSTIC_LOG_RETENTION_HOURS=168
HG_AI_AI_ERROR_RETENTION_HOURS=48
HG_AI_RETENTION_CLEANUP_SECONDS=60
HG_AI_RETENTION_MAX_FILE_BYTES=1048576
HG_AI_RETENTION_MAX_TOTAL_BYTES=4194304
HG_AI_RETENTION_MAX_EVENTS=2000
# Gate 4: disabled until an explicitly authorized live run; never guessed from history.
HG_AI_ENGINE_LIVE_ENABLED=false
HG_AI_ENGINE_TOKEN_FORMAT=hex
# HG_AI_ENGINE_ORIGIN=https://<approved-private-IP>:<verified-port>
# HG_AI_ENGINE_CERTIFICATE_FILE=<approved-enrolled-public-certificate.pem>
# HG_AI_ENGINE_CERTIFICATE_SHA256=<independently-verified-SHA256>
# HG_AI_ENGINE_TOKEN_FILE=<approved-owner-only-engine-token-file>
# HG_AI_AI_CLIENT_TOKEN_FILE=<different-owner-only-ai-client-token-file>
HG_AI_ENGINE_TIMEOUT=3
HG_AI_ENGINE_MAX_AGE_SECONDS=60
