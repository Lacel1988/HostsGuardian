# REVIEW TEMPLATE ONLY. PID1 owns the listener; ordinary users cannot replace it.
[Unit]
Description=HostsGuardian protected validator endpoint

[Socket]
ListenStream=/run/hostsguardian-validator/validator.sock
SocketUser=root
SocketGroup=@ENGINE_GROUP@
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
Accept=no
Service=hostsguardian-network-validator.service
Backlog=2

[Install]
WantedBy=sockets.target
