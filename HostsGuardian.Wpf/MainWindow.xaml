<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:vm="clr-namespace:HostsGuardian.Wpf.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="HostsGuardian.Wpf.MainWindow" Title="HostsGuardian" Width="1200" Height="760" WindowStartupLocation="CenterScreen" MinWidth="1000" MinHeight="640">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource MatrixPanel}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HostsGuardian" FontSize="23" VerticalAlignment="Center" FontFamily="{StaticResource OrbitronFont}" Foreground="{StaticResource GreenBrush}" />
                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Engine connection" Click="EngineSettings_Click" Margin="0,0,10,0" Padding="12,7" Style="{StaticResource SecondaryButton}" ToolTip="Configure the HTTPS management endpoint and protected credentials" />
                    <Button Content="FLUSH DNS" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,10,0" Command="{Binding FlushDnsCommand}" />
                    <Border Width="16" Height="16" Margin="0,0,8,0" CornerRadius="8" Background="{Binding StatusLedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                </WrapPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource MatrixPanel}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding CurrentPageTitle}" FontSize="20" Margin="0,0,0,10" />
                        <Border Grid.Row="1" Padding="12" Margin="0,0,0,10" Style="{StaticResource MatrixPanel}">
                            <StackPanel>
                                <TextBlock Text="Quick actions" FontSize="14" Margin="0,0,0,10" Style="{StaticResource SectionHeading}" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="APPLY HOSTS" Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="0,0,10,0" Command="{Binding ApplyHostsCommand}" />
                                    <Button Content="REVERT" Style="{StaticResource SecondaryButton}" Padding="12,7" Command="{Binding RevertHostsCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding AdminHintText}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Padding="12" Margin="0,0,0,10" Style="{StaticResource MatrixPanel}">
                            <StackPanel>
                                <TextBlock Text="DNS engine / router" FontSize="14" Margin="0,0,0,10" Style="{StaticResource SectionHeading}" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Router IP:" Foreground="{StaticResource SubTextBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RouterIp}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="DNS target:" Margin="0,6,0,0" Foreground="{StaticResource SubTextBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DnsTargetIp}" Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Engine API:" Margin="0,6,0,0" Foreground="{StaticResource SubTextBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding EngineApiBaseUrl}" Margin="0,3,0,0" Grid.ColumnSpan="2" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Engine:" Margin="0,6,0,0" Foreground="{StaticResource SubTextBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EngineStatusText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </Grid>
                                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="DETECT ROUTER" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,10,0" Command="{Binding DetectRouterCommand}" />
                                    <Button Content="PING ENGINE" Style="{StaticResource SecondaryButton}" Padding="12,7" Command="{Binding PingEngineCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="3" Padding="12" Margin="0,0,0,10" Style="{StaticResource MatrixPanel}">
                            <StackPanel>
                                <TextBlock Text="Add domain" FontSize="14" Margin="0,0,0,10" Style="{StaticResource SectionHeading}" />
                                <TextBox Text="{Binding NewDomainText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MatrixTextBox}" Height="36" />
                                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="ADD" Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="0,0,10,0" Command="{Binding AddDomainCommand}" />
                                    <Button Content="CLEAR" Style="{StaticResource SecondaryButton}" Padding="12,7" Command="{Binding ClearNewDomainCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding DomainInputHintText}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="5" Padding="12" Style="{StaticResource MatrixPanel}">
                            <StackPanel>
                                <TextBlock Text="Preview" FontSize="14" Margin="0,0,0,10" Style="{StaticResource SectionHeading}" />
                                <TextBlock Text="{Binding PreviewTitle}" FontSize="13" Margin="0,0,0,6" />
                                <TextBox Text="{Binding PreviewBody, Mode=OneWay}" IsReadOnly="True" Height="150" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <Border Grid.Column="1" />
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CurrentPageSubtitle}" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                        <WrapPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="REFRESH" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,10,0" Command="{Binding RefreshCurrentPageCommand}" />
                            <Button Content="EXPORT" Style="{StaticResource SecondaryButton}" Padding="12,7" Command="{Binding ExportCommand}" />
                        </WrapPanel>
                    </Grid>
                    <Border Grid.Row="1" Padding="10" Margin="0,0,0,10" Style="{StaticResource MatrixPanel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Search" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MatrixTextBox}" Height="36" Grid.Column="1" ToolTip="Type to filter domains / devices / logs" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <TabControl Background="Transparent" BorderThickness="0">
                            <TabItem Header="DOMAINS" IsSelected="{Binding IsDomainsVisible, Mode=TwoWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DataGrid ItemsSource="{Binding DomainsView}" SelectedItem="{Binding SelectedDomain}" Style="{StaticResource MatrixDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="DOMAIN" Binding="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="180" EditingElementStyle="{StaticResource GridTextEditor}" ElementStyle="{StaticResource GridText}" />
                                            <DataGridCheckBoxColumn Header="HOSTS" Binding="{Binding HostsBlocked, UpdateSourceTrigger=PropertyChanged}" Width="90" ElementStyle="{StaticResource GridCheckBoxDisplay}" EditingElementStyle="{StaticResource {x:Type CheckBox}}" MinWidth="90" />
                                            <DataGridCheckBoxColumn Header="DNS" Binding="{Binding DnsBlocked, UpdateSourceTrigger=PropertyChanged}" Width="70" ElementStyle="{StaticResource GridCheckBoxDisplay}" EditingElementStyle="{StaticResource {x:Type CheckBox}}" MinWidth="70" />
                                            <DataGridTextColumn Header="NOTES" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="260" MinWidth="260" EditingElementStyle="{StaticResource GridTextEditor}" ElementStyle="{StaticResource GridText}" />
                                        </DataGrid.Columns>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Setter Property="ToolTip" Value="{Binding Domain}" />
                                            </Style>
                                        </DataGrid.RowStyle>
                                    </DataGrid>
                                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="REMOVE" Style="{StaticResource DangerButton}" Padding="12,7" Margin="0,0,10,0" Command="{Binding RemoveDomainCommand}" />
                                        <Button Content="APPLY HOSTS" Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="0,0,10,0" Command="{Binding ApplyHostsCommand}" />
                                        <Button Content="PUSH DNS" Style="{StaticResource PrimaryButton}" Padding="12,7" Command="{Binding PushDnsCommand}" />
                                    </WrapPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="ROUTER" IsSelected="{Binding IsRouterVisible, Mode=TwoWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Padding="12" Margin="0,0,0,10" Style="{StaticResource MatrixPanel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Router detection" FontSize="14" Margin="0,0,0,6" Style="{StaticResource SectionHeading}" />
                                                <TextBlock Text="{Binding RouterSummaryText}" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" />
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="DETECT" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,10,0" Command="{Binding DetectRouterCommand}" />
                                                <Button Content="OPEN ROUTER" Style="{StaticResource SecondaryButton}" Padding="12,7" Command="{Binding OpenRouterUiCommand}" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding RouterCandidatesView}" SelectedItem="{Binding SelectedRouterCandidate}" Style="{StaticResource MatrixDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="125" MinWidth="125" EditingElementStyle="{StaticResource GridTextEditor}" ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="180" MinWidth="180" EditingElementStyle="{StaticResource GridTextEditor}" ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="SCORE" Binding="{Binding Score}" Width="80" MinWidth="80" EditingElementStyle="{StaticResource GridTextEditor}" ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="DETAILS" Binding="{Binding Details}" Width="*" MinWidth="220" EditingElementStyle="{StaticResource GridTextEditor}" ElementStyle="{StaticResource GridText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="DEVICES" IsSelected="{Binding IsDevicesVisible, Mode=TwoWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Padding="12" Margin="0,0,0,10" Style="{StaticResource MatrixPanel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Device discovery" FontSize="14" Margin="0,0,0,6" Style="{StaticResource SectionHeading}" />
                                                <TextBlock Text="{Binding DevicesSummaryText}" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" />
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="SCAN" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,10,0" Command="{Binding ScanDevicesCommand}" />
                                                <Button Content="SAVE" Style="{StaticResource PrimaryButton}" Padding="12,7" Command="{Binding SaveDevicesCommand}" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding DevicesView}" SelectedItem="{Binding SelectedDevice}" Style="{StaticResource MatrixDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="125" MinWidth="125" EditingElementStyle="{StaticResource GridTextEditor}" ElementStyle="{StaticResource GridText}" />
                                            <DataGridTemplateColumn Header="ICON" Width="52" MinWidth="52">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontFamily="Segoe UI Emoji" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding Kind}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding Icon}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Unknown">
                                                                            <Setter Property="Text" Value="○" />
                                                                            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="NAME" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="130" EditingElementStyle="{StaticResource GridTextEditor}" ElementStyle="{StaticResource GridText}" />
                                            <DataGridCheckBoxColumn Header="DNS BLOCK" Binding="{Binding DnsBlocked, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource GridCheckBoxDisplay}" EditingElementStyle="{StaticResource {x:Type CheckBox}}" MinWidth="100" />
                                            <DataGridTextColumn Header="MAC" IsReadOnly="True" Binding="{Binding Mac}" Width="158" MinWidth="158" EditingElementStyle="{StaticResource GridTextEditor}" ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="HOSTNAME" IsReadOnly="True" Binding="{Binding Hostname}" Width="*" MinWidth="145" EditingElementStyle="{StaticResource GridTextEditor}" ElementStyle="{StaticResource GridText}" />
                                        </DataGrid.Columns>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Setter Property="ToolTip" Value="{Binding Name}" />
                                            </Style>
                                        </DataGrid.RowStyle>
                                    </DataGrid>
                                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="BLOCK SELECTED" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,10,0" Command="{Binding BlockSelectedDeviceCommand}" />
                                        <Button Content="UNBLOCK SELECTED" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,10,0" Command="{Binding UnblockSelectedDeviceCommand}" />
                                        <Button Content="PUSH DNS" Style="{StaticResource PrimaryButton}" Padding="12,7" Command="{Binding PushDnsCommand}" />
                                    </WrapPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="LOG" IsSelected="{Binding IsLogVisible, Mode=TwoWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DataGrid ItemsSource="{Binding LogView}" SelectedItem="{Binding SelectedLog}" Style="{StaticResource MatrixDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="170" MinWidth="170" EditingElementStyle="{StaticResource GridTextEditor}" ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="LEVEL" Binding="{Binding Level}" Width="90" MinWidth="90" EditingElementStyle="{StaticResource GridTextEditor}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="INFO">
                                                                <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*" MinWidth="220" EditingElementStyle="{StaticResource GridTextEditor}" ElementStyle="{StaticResource GridText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="COPY" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,10,0" Command="{Binding CopySelectedLogCommand}" />
                                        <Button Content="CLEAR" Style="{StaticResource DangerButton}" Padding="12,7" Command="{Binding ClearLogCommand}" />
                                    </WrapPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
