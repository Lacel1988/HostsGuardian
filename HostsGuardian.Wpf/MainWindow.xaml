<Window x:Class="HostsGuardian.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HostsGuardian"
        Width="1200" Height="740"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: domain blocking -->
        <Border Grid.Column="0" Style="{StaticResource MatrixPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="DOMAIN BLOCKING"
                           FontSize="26"
                           Margin="0,0,0,6"/>

                <StackPanel Grid.Row="2" Orientation="Vertical">
                    <TextBlock Text="ADD DOMAIN" Opacity="0.85" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewDomain, UpdateSourceTrigger=PropertyChanged}"
                             Width="340"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="ADD"
                                Style="{StaticResource MatrixButton3D}"
                                Command="{Binding AddDomainCommand}"
                                Width="140"/>
                        <Button Content="REFRESH"
                                Style="{StaticResource MatrixButton3D}"
                                Command="{Binding RefreshCommand}"
                                Width="160"
                                Margin="10,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="SEARCH" Opacity="0.85" Margin="0,18,0,6"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Width="340"/>
                </StackPanel>

                <ListBox Grid.Row="4"
                         ItemsSource="{Binding FilteredDomains}"
                         SelectedItem="{Binding SelectedDomain}"
                         Margin="0,10,0,10"/>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="PREVIEW"
                            Style="{StaticResource MatrixButton3D}"
                            Command="{Binding PreviewCommand}"
                            Width="140"/>

                    <Button Content="APPLY"
                            Style="{StaticResource MatrixButton3D}"
                            Command="{Binding ApplyCommand}"
                            Width="140"
                            Margin="10,0,0,0"/>

                    <Button Content="REVERT"
                            Style="{StaticResource MatrixButton3D}"
                            Command="{Binding RevertCommand}"
                            Width="140"
                            Margin="10,0,0,0"/>

                    <Button Content="REMOVE"
                            Style="{StaticResource MatrixButton3DDanger}"
                            Command="{Binding RemoveDomainCommand}"
                            Width="140"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT: activity -->
        <Border Grid.Column="2" Style="{StaticResource MatrixPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="ACTIVITY"
                           FontSize="26"
                           Margin="0,0,0,6"/>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding ActivityItems}"
                         Margin="0,10,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Header}" Opacity="0.85"/>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="EXPORT CSV"
                            Style="{StaticResource MatrixButton3D}"
                            Command="{Binding ExportCsvCommand}"
                            Width="160"/>
                    <Button Content="EXPORT JSON"
                            Style="{StaticResource MatrixButton3D}"
                            Command="{Binding ExportJsonCommand}"
                            Width="160"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
