        </Border>
        <Border x:Name="NotificationPanel" Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="20" Width="460" HorizontalAlignment="Right" VerticalAlignment="Top" MaxHeight="540" Padding="14" Style="{StaticResource MatrixPanel}" Visibility="{Binding NotificationsOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel><StackPanel DockPanel.Dock="Top"><WrapPanel><TextBlock Text="{loc:Text S180}" Style="{StaticResource SectionHeading}" Margin="0,0,14,0"/><Button Content="{loc:Text S234}" Command="{Binding MarkNotificationsReadCommand}"/><Button Content="{loc:Text S235}" Command="{Binding ToggleNotificationsCommand}" Margin="8,0,0,0"/></WrapPanel>
            <Expander Header="{loc:Text S236}" Margin="0,8"><StackPanel><CheckBox Content="{loc:Text S237}" IsChecked="{Binding NotifyEngine}"/><CheckBox Content="{loc:Text S238}" IsChecked="{Binding NotifyPolicy}"/><CheckBox Content="{loc:Text S239}" IsChecked="{Binding NotifyDevices}"/><CheckBox Content="{loc:Text S240}" IsChecked="{Binding NotifyRecovery}"/><TextBlock Text="{loc:Text S241}" Style="{StaticResource HelperText}"/></StackPanel></Expander></StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{loc:Text S242}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HelperText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Notifications.Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <ItemsControl ItemsSource="{Binding Notifications.Items}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#42795B" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel><WrapPanel><TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold" Margin="0,0,8,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Severity}" Value="Critical"><Setter Property="Foreground" Value="{StaticResource RedBrush}"/></DataTrigger><DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding StateText}"/><TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Margin="0,4"/><Button Content="{loc:Text S243}" Click="Notification_Click" HorizontalAlignment="Left"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></DockPanel>
        </Border>
    </Grid>
</Window>
