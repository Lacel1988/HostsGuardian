<Window x:Class="HostsGuardian.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HostsGuardian.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="HostsGuardian"
        Width="1200" Height="760"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Style="{StaticResource MatrixPanel}"
                Padding="12"
                Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <TextBlock Text="HOSTSGUARDIAN"
                           FontSize="26"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="DOMAINS"
                            Style="{StaticResource MatrixButton}"
                            Command="{Binding ShowDomainsCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="ROUTER"
                            Style="{StaticResource MatrixButton}"
                            Command="{Binding ShowRouterCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="DNS"
                            Style="{StaticResource MatrixButton}"
                            Command="{Binding ShowDnsCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">

            <!-- DOMAINS PAGE -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource MatrixPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDomainsPage}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT -->
                    <Border Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="DOMAIN BLOCKING" FontSize="28" />

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="STATUS" Margin="0,0,8,0" FontSize="14" VerticalAlignment="Center"/>

                                    <Ellipse Width="14" Height="14" Stroke="{StaticResource GreenBrush}" StrokeThickness="2">
                                        <Ellipse.Style>
                                            <Style TargetType="{x:Type Ellipse}">
                                                <Setter Property="Fill" Value="{StaticResource RedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HostsBlockActive}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <Button Content="DNS FLUSH"
                                            Style="{StaticResource MatrixButton}"
                                            Margin="16,0,0,0"
                                            Command="{Binding FlushDnsCommand}"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="ADD DOMAIN" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding NewDomain, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,12,0"/>

                                <Button Grid.Column="2"
                                        Content="ADD"
                                        Style="{StaticResource MatrixButton}"
                                        Margin="0,0,12,0"
                                        Command="{Binding AddDomainCommand}"/>

                                <Button Grid.Column="3"
                                        Content="REFRESH"
                                        Style="{StaticResource MatrixButton}"
                                        Command="{Binding RefreshCommand}"/>
                            </Grid>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding Domains}"
                                     SelectedItem="{Binding SelectedDomain}"
                                     DisplayMemberPath="Domain"/>

                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="PREVIEW"
                                        Style="{StaticResource MatrixButton}"
                                        Margin="0,0,10,0"
                                        Command="{Binding PreviewCommand}"/>

                                <Button Grid.Column="1"
                                        Content="APPLY"
                                        Style="{StaticResource MatrixButton}"
                                        Margin="0,0,10,0"
                                        Command="{Binding ApplyCommand}"/>

                                <Button Grid.Column="2"
                                        Content="REVERT"
                                        Style="{StaticResource MatrixButton}"
                                        Margin="0,0,10,0"
                                        Command="{Binding RevertCommand}"/>

                                <Button Grid.Column="3"
                                        Content="REMOVE"
                                        Style="{StaticResource MatrixButtonDanger}"
                                        Command="{Binding RemoveSelectedDomainCommand}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- RIGHT -->
                    <Border Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ACTIVITY" FontSize="28" Margin="0,0,0,10"/>

                            <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLines}" />

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="EXPORT CSV"
                                        Style="{StaticResource MatrixButton}"
                                        Margin="0,0,10,0"
                                        Command="{Binding ExportCsvCommand}"/>

                                <Button Grid.Column="1"
                                        Content="EXPORT JSON"
                                        Style="{StaticResource MatrixButton}"
                                        Command="{Binding ExportJsonCommand}"/>
                            </Grid>

                            <Expander Grid.Row="3"
                                      Header="PREVIEW PANEL"
                                      IsExpanded="{Binding IsPreviewOpen}"
                                      Margin="0,12,0,0">
                                <TextBox Text="{Binding PreviewText}"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         IsReadOnly="True"
                                         FontSize="12"
                                         Height="220"/>
                            </Expander>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ROUTER PAGE -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource MatrixPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRouterPage}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ROUTER / LAN DEVICES" FontSize="28" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="DETECT"
                                Style="{StaticResource MatrixButton}"
                                Command="{Binding DetectRouterCommand}"
                                Margin="0,0,10,0"/>

                        <Button Content="SCAN"
                                Style="{StaticResource MatrixButton}"
                                Command="{Binding ScanDevicesCommand}"
                                Margin="0,0,10,0"/>

                        <Button Content="SAVE POLICIES"
                                Style="{StaticResource MatrixButton}"
                                Command="{Binding SaveDevicePoliciesCommand}"/>

                        <TextBlock Text="{Binding DevicesHint}"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding RouterSummaryLine1}" />
                        <TextBlock Grid.Row="1" Text="{Binding RouterSummaryLine2}" />
                        <TextBlock Grid.Row="2" Text="{Binding RouterSummaryLine3}" />

                        <TextBox Grid.Row="3"
                                 Text="{Binding NetworkSnapshot}"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 Height="120"
                                 Margin="0,10,0,10"/>

                        <DataGrid Grid.Row="4"
                                  ItemsSource="{Binding Devices}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" IsReadOnly="True" Width="2*" />
                                <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" IsReadOnly="True" Width="2*" />
                                <DataGridTextColumn Header="NAME" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="3*" />
                                <DataGridTextColumn Header="HOSTNAME" Binding="{Binding Hostname}" IsReadOnly="True" Width="3*" />
                                <DataGridCheckBoxColumn Header="DNS BLOCK" Binding="{Binding DnsBlocked}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <TextBlock Grid.Row="3" Text="{Binding RouterFooter}" Margin="0,12,0,0" Opacity="0.85"/>
                </Grid>
            </Border>

            <!-- DNS PAGE -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource MatrixPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDnsPage}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DNS PANEL" FontSize="28" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="REFRESH"
                                Style="{StaticResource MatrixButton}"
                                Command="{Binding RefreshDnsPanelCommand}"
                                Margin="0,0,10,0"/>

                        <Button Content="DNS FLUSH"
                                Style="{StaticResource MatrixButton}"
                                Command="{Binding FlushDnsCommand}"/>
                    </StackPanel>

                    <TextBox Grid.Row="2"
                             Text="{Binding DnsSnapshot}"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
