<Application x:Class="HostsGuardian.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <!-- MATRIX PALETTE -->
        <Color x:Key="M_Bg">#FF050607</Color>
        <Color x:Key="M_Panel">#FF0A0D0B</Color>
        <Color x:Key="M_Green">#FF00FF66</Color>
        <Color x:Key="M_GreenDim">#AA00FF66</Color>
        <Color x:Key="M_GreenSoft">#3300FF66</Color>
        <Color x:Key="M_Text">#FFE6FFF0</Color>
        <Color x:Key="M_SubText">#BFE6FFF0</Color>
        <Color x:Key="M_Red">#FFFF3B3B</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource M_Bg}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource M_Panel}" />
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource M_Green}" />
        <SolidColorBrush x:Key="GreenDimBrush" Color="{StaticResource M_GreenDim}" />
        <SolidColorBrush x:Key="GreenSoftBrush" Color="{StaticResource M_GreenSoft}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource M_Text}" />
        <SolidColorBrush x:Key="SubTextBrush" Color="{StaticResource M_SubText}" />
        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource M_Red}" />

        <!-- BASE WINDOW -->
        <Style TargetType="{x:Type Window}">
            <Setter Property="Background" Value="{StaticResource BgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FF070A08" />
            <Setter Property="BorderBrush" Value="{StaticResource GreenDimBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="{StaticResource GreenBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource GreenSoftBrush}" />
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="#FF070A08" />
            <Setter Property="BorderBrush" Value="{StaticResource GreenDimBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="#FF070A08"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GreenDimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FF070A08"/>
            <Setter Property="AlternatingRowBackground" Value="#FF060807"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#FF0A0D0B"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GreenDimBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MatrixPanel" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GreenDimBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- SIMPLE MATRIX BUTTON -->
        <Style x:Key="MatrixButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FF050B07"/>
            <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF0C2212"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF031008"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MatrixButtonDanger" TargetType="{x:Type Button}" BasedOn="{StaticResource MatrixButton}">
            <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
        </Style>

    </Application.Resources>
</Application>
